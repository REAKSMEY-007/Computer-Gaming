# Copy this file to `.env` and fill in your real values.
PORT=3000
# Local MongoDB (dev): mongodb://localhost:27017/computer-store
# MongoDB Atlas (production) URI template:
# Format:  mongodb+srv://<dbUser>:<dbPassword>@<clusterName>.<clusterSuffix>.mongodb.net/<dbName>?retryWrites=true&w=majority
# Example: mongodb+srv://cngstoreUser:YourPassword123@cluster0.ab1cd2e.mongodb.net/computer-store?retryWrites=true&w=majority
# NOTE: URL-encode special characters in the password (@ -> %40, : -> %3A, # -> %23).
MONGO_URI=mongodb://localhost:27017/computer-store
JWT_SECRET=change-me
GOOGLE_CLIENT_ID=your-google-client-id

# ------- Bank Transfer / KHQR payment (edit these with your real details) -------
BANK_ACCOUNT_NAME=Your Name Here
BANK_ACCOUNT_NUMBER=0000 0000 0000 0000
BANK_NAME=Your Bank
KHQR_IMAGE=/uploads/khqr/khqr.png
BANK_PAYMENT_NOTE=Please include your order number in the transfer note.

# ------- Bakong KHQR Payment (from the Bakong Developer portal) -------
# Business/merchant Bakong account used as the payee for KHQR payments.
BAKONG_ACCOUNT_ID=your_bakong_account_id@bkrt
# Developer API token used to authenticate /v1/* Bakong API calls (Bearer auth).
BAKONG_TOKEN=your-bakong-developer-api-token
# Merchant details embedded in the KHQR payload (shown in the customer's bank app).
BAKONG_MERCHANT_NAME=Your Store Name
BAKONG_MERCHANT_CITY=Phnom Penh
# Replace with the merchant ID / acquiring bank code from your Bakong Developer
# portal (ABA Bank = "ABBANK" from the merchant account).
BAKONG_MERCHANT_ID=001
BAKONG_ACQUIRING_BANK=ABA
# Bakong API base URL (production network). May be the API root OR the full
# verify endpoint — the controller normalises both forms.
# Root form:            https://api-bakong.nbc.gov.kh
# Full endpoint form:   https://api-bakong.nbc.gov.kh/v1/check_transaction_by_md5
# Swap to the sandbox host if you were issued a sandbox-only URL.
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1/check_transaction_by_md5

# Dev fallback: a sandbox-only developer token cannot verify a real merchant
# QR, so 401/404 responses from Bakong are treated as "paid" so local testing
# can proceed to /payment-success. Keep false in production.
DEV_PAYMENT_BYPASS=false

# ------- Cloudinary (product image uploads) -------
# When set, product images are uploaded to Cloudinary instead of the local
# uploads/ directory (required on Render, where local storage is not
# persistent). If these are left blank the backend falls back to local disk.
# Get the values from your Cloudinary Dashboard.
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me